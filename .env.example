# ---- foodi ----------------------------------------------------------------
# Copy to .env and fill in. Everything has a local-dev default except the two secrets.

NODE_ENV=development
PORT=4100
FOODI_APP_ORIGIN=http://localhost:5100
FOODI_API_ORIGIN=http://localhost:4100
FOODI_DB_PATH=./data/foodi.db

# Generate both with: npm run secrets
FOODI_SESSION_SECRET=
FOODI_ENCRYPTION_KEY=

# Dev-only fake identity provider + fake AI so the whole app works with no credentials.
# Ignored (forced off) when NODE_ENV=production.
FOODI_ENABLE_MOCK_PROVIDER=true

# The house kitchen (@foodi) seeds 50+ starter recipes and shares one to the feed now and then.
FOODI_HOUSE_KITCHEN=true

# Development only: first person to sign in becomes admin when no admin exists (ignored in production).
# FOODI_BOOTSTRAP_FIRST_ADMIN=true
# Promote by email, comma-separated. Only applies to sign-ins whose provider verified the email
# (OIDC email_verified) — never to a self-typed password registration. For those, use:
#   npm run make-admin -- you@example.com
FOODI_ADMIN_EMAILS=

# ---- OpenAI: "Continue with ChatGPT" (OAuth 2.0 + PKCE + OIDC) ----------------------
# Register an OAuth client with OpenAI and paste it here. Leave blank to fall back to
# "connect with an API key". Redirect URI to register: ${FOODI_API_ORIGIN}/api/auth/openai/callback
OPENAI_OAUTH_CLIENT_ID=
OPENAI_OAUTH_CLIENT_SECRET=
OPENAI_OAUTH_ISSUER=https://auth.openai.com
OPENAI_OAUTH_SCOPES=openid profile email offline_access
OPENAI_OAUTH_EXCHANGE_API_KEY=true
OPENAI_MODEL=gpt-5

# ---- Photo libraries (recipe covers) ------------------------------------------------------
# Recipes without an image-capable AI get a photo of the dish from a library. Wikimedia Commons
# needs no key. For much better food photography add one or both of:
#   Pexels (free, license-safe): https://www.pexels.com/api/
#   Google Images via the Custom Search JSON API (100 free searches/day; needs a search engine
#   id with "image search" on): https://programmablesearchengine.google.com/
PEXELS_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ---- Anthropic: "Continue with Claude" (API key) ------------------------------------
# Anthropic does not permit third-party Claude.ai sign-in, so people connect a Console
# API key instead. Nothing to configure here besides the model.
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Optional generic OIDC provider (for a future sanctioned flow) --------------------
# GENERIC_OAUTH_VENDOR=anthropic
# GENERIC_OAUTH_LABEL=Continue with Claude
# GENERIC_OAUTH_CLIENT_ID=
# GENERIC_OAUTH_CLIENT_SECRET=
# GENERIC_OAUTH_ISSUER=
# GENERIC_OAUTH_SCOPES=openid profile email

# ---- Payments (selling recipe books, buying promotions) -----------------------------------
# Without a Stripe key, checkouts run in test mode: a fake in-app page completes the order and
# nothing is charged. With a key, Stripe Checkout is used; the webhook secret is required so
# paid orders complete. Webhook endpoint: ${FOODI_API_ORIGIN}/api/payments/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
